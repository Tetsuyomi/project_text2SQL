# Конфигурация базы данных
DATABASE_URL=postgresql+asyncpg://username:password@host:port/database

# Примеры для разных сценариев:

# Локальная база данных
# DATABASE_URL=postgresql+asyncpg://readonly_user:readonly_user@localhost:5432/dtp-map-db

# Удаленная база данных
# DATABASE_URL=postgresql+asyncpg://user:pass@remote-host:5432/database_name

# База данных в Docker
# DATABASE_URL=postgresql+asyncpg://readonly_user:readonly_user@db:5432/dtp-map-db

# Дополнительные настройки (опционально)
PYTHONUNBUFFERED=1
LOG_LEVEL=INFO
